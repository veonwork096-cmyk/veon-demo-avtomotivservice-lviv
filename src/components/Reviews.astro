---
import Icon from "./Icon.astro";
import { REVIEWS, MAP_HREF } from "../data/site";
---
<section id="reviews" class="reviews" data-rec="R-105" aria-labelledby="reviews-title">
  <div class="container reviews__grid">
    <div class="reviews__score">
      <h2 id="reviews-title" class="visually-hidden">Відгуки</h2>
      <p class="reviews__big num" aria-hidden="true">5,0</p>
      <p class="stars stars--lg" aria-hidden="true">{[1, 2, 3, 4, 5].map(() => <Icon name="star" size={28} />)}</p>
      <p class="reviews__count"><span class="visually-hidden">Рейтинг 5,0 з 5, </span><span class="num">193</span> відгуки в Google</p>
      <a class="text-link" href={MAP_HREF} target="_blank" rel="noopener">Усі відгуки на Google Maps<span class="visually-hidden"> (нова вкладка)</span><Icon name="arrow" size={18} /></a>
    </div>
    <figure class="reviews__quotes">
      <figcaption class="reviews__caption">Вибрані відгуки з Google</figcaption>
      <ul class="quotes">
        {REVIEWS.map((r) => (
          <li class="quote">
            <blockquote class="quote__text"><p>«{r.text}»</p></blockquote>
            <p class="quote__author">{r.author}</p>
          </li>
        ))}
      </ul>
    </figure>
  </div>
</section>
